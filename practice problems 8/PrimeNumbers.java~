import hsa.Console;

public class PrimeNumbers
{
  static Console c;
 
  public static void main (String[] args) {
    c = new Console();
    
    int x;
    String isPrimeNum = "";
    int t = 0; 
    int h = 0; 
    
    c.print("Enter a number: ");
    x = c.readInt(); 
    
    for(int i = 1; i <= x; ++i)
    {
      double y = x/i; 
      
      if(y == 1)
      {
        ++t;
      }
      else 
      {
        ++h;
      }
    }
    if(t > h)
    {
      c.print(x + " is a prime number"); 
    }
    else 
    {
      c.print(x + " is not a prime number");
    }
  }
}