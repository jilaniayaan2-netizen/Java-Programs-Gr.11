import hsa.Console;

public class YoureaStar
{
  static Console c;
 
  public static void main (String[] args) {
    c = new Console();
    
    String whichPattern; 
    c.print("Which pattern do you want? Enter A, B, C, D: "); 
    whichPattern = c.readString(); 
    
    if(whichPattern.equals("A"))
    { 
      for(int rows = 0; i <= 5; ++rows)
      { 
        for(int i = 0; i <= 5; ++i)
        { 
          c.print("*");
        }
        c.println();
      }
    }
  }
}