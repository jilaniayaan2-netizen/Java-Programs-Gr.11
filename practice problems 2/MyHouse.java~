import hsa.Console;
import java.awt.*;

public class MyHouse
{
  static Console c;
 
  public static void main (String[] args) {
    c = new Console();
    
    //body
    c.setColor(new Color(194, 110, 31));
    c.fillRect(200, 200, 200, 200);
    c.setColor(Color.black);
    c.drawRect(200, 200, 200, 200);
    
    //door
    c.setColor(Color.black);
    c.drawRect(275, 325, 50, 75);
    
    //windows
    c.setColor(new Color(132, 243, 245));
    c.fillRect(225, 225, 50, 50);
    c.fillRect(325, 225, 50, 50);
    c.setColor(Color.black);
    c.drawRect(225, 225, 50, 50);
    c.drawRect(325, 225, 50, 50);
    
    //roof
    c.setColor(Color.black);
    c.drawLine(200, 200, 300, 100);
    c.drawLine(300, 100, 400, 200);
  }
}
