import hsa.Console;
import java.awt.*;

public class DrawingRectangles
{
  static Console c;
 
  public static void main (String[] args) {
    c = new Console();
    
    int height = 100; 
    int width = 200;
    
    c.drawRect((c.getWidth() - width/2), (c.getHeight() - height/2), width, height);
  }
}